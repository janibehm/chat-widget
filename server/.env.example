# ---------------------------------------------------------------------------
# Kopioi tämä tiedosto nimelle .env ja täytä arvot. .env on gitignoressa.
# ---------------------------------------------------------------------------

# Palvelimen portti
PORT=8787

# LLM-tarjoaja: "anthropic" tai "openai"
LLM_PROVIDER=openai

# Malli. Jätä tyhjäksi niin käytetään tarjoajan oletusta (ks. src/llm/client.ts)
LLM_MODEL=gpt-5-mini

# API-avaimet - vain se jota LLM_PROVIDER käyttää on pakollinen
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# CORS: pilkulla erotettu lista sallittuja origineja.
# Widget upotetaan vieraille domaineille, joten nämä pitää listata tässä.
# "*" sallii kaikki - kätevä kehityksessä, älä käytä tuotannossa.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# n8n-webhook johon automaatiotapahtumat lähetetään. Tyhjä = ei lähetetä.
N8N_WEBHOOK_URL=

# Valinnainen jaettu salaisuus, menee X-Webhook-Secret-otsakkeessa n8n:lle
N8N_WEBHOOK_SECRET=

# Jaettu salaisuus POST /admin/sync -kutsulle (n8n-synkronointi).
# Tyhja = endpoint pois kaytosta.
ADMIN_SYNC_SECRET=
